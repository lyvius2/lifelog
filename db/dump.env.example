# db/dump.env 로 복사해 사용하십시오. dump.env 는 .gitignore 에 등록되어 있습니다.
# 값은 애플리케이션 컨테이너에 주는 것과 같습니다 — docker/lifelog.env 의
# MYSQL_* 와 MONGODB_URI 를 그대로 쓰면 됩니다.
# (여기의 MYSQL_USER / MONGO_URI 는 mysqldump · mongodump 의 인자명에 맞춘 것이라
#  애플리케이션 쪽 MYSQL_USERNAME / MONGODB_URI 와 이름이 다릅니다.)

MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=lifelog

# PostgreSQL 은 현재 애플리케이션에서 쓰지 않습니다. 구 DB 의 posts_log 를
# 보관용으로 받아 둘 때만 채우십시오. 비워 두면 건너뜁니다.
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=

MONGO_URI=
