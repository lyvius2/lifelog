# db/dump.env 로 복사해 사용하십시오. dump.env 는 .gitignore 에 등록되어 있습니다.
# 값은 기존 application-live.yml 의 ENC(...) 를 복호화해 얻을 수 있습니다.
#   java -cp jasypt.jar org.jasypt.intf.cli.JasyptPBEStringDecryptionCLI \
#        input="암호문" password="$JASYPT_ENCRYPTOR_PASSWORD" algorithm=PBEWithMD5AndDES

MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=lifelog

# PostgreSQL 은 현재 애플리케이션에서 쓰지 않습니다. 구 DB 의 posts_log 를
# 보관용으로 받아 둘 때만 채우십시오. 비워 두면 건너뜁니다.
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=

MONGO_URI=
