# lifelog-worker 컨테이너 환경변수 템플릿
#   cp docker/lifelog-worker.env.example docker/lifelog-worker.env
#   docker run --env-file docker/lifelog-worker.env ...
#
# 주의: worker 모듈에는 jasypt-spring-boot-starter 의존성이 없습니다.
#       ENC(...) 가 복호화되지 않으므로 아래 값은 모두 평문이어야 합니다.
#       worker/application.yml 의 값이 전부 비어 있어 아래 주입이 사실상 필수입니다.

# --- OpenAI ---
SPRING_AI_OPENAI_API_KEY=

# --- Redis ---
SPRING_DATA_REDIS_URL=
SPRING_DATA_REDIS_SSL_ENABLED=true

# --- Kafka ---
SPRING_KAFKA_BOOTSTRAP_SERVERS=
SPRING_KAFKA_CONSUMER_GROUPID=
KAFKA_SSL_KEYLOCATION=file:/app/certs/service.key
KAFKA_SSL_CERTIFICATELOCATION=file:/app/certs/service.cert
KAFKA_SSL_CALOCATION=file:/app/certs/ca.pem

# --- MySQL (worker.datasource.mysql.*) ---
WORKER_DATASOURCE_MYSQL_JDBCURL=
WORKER_DATASOURCE_MYSQL_USERNAME=
WORKER_DATASOURCE_MYSQL_PASSWORD=

# --- PostgreSQL (worker.datasource.postgres.*) ---
WORKER_DATASOURCE_POSTGRES_JDBCURL=
WORKER_DATASOURCE_POSTGRES_USERNAME=
WORKER_DATASOURCE_POSTGRES_PASSWORD=
WORKER_DATASOURCE_POSTGRES_SSL_ENABLED=true
WORKER_DATASOURCE_POSTGRES_SSL_MODE=require
WORKER_DATASOURCE_POSTGRES_SSL_ROOTCERT=file:/app/certs/pg-ca.pem
