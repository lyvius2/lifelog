# lifelog 컨테이너 환경변수 템플릿
#   cp docker/lifelog.env.example docker/lifelog.env  (lifelog.env 는 gitignore 대상)
#   docker run --env-file docker/lifelog.env ...
#
# Spring relaxed binding 규칙: 점 -> 밑줄, 대시 제거, 전부 대문자
#   spring.datasource.url      -> SPRING_DATASOURCE_URL
#   photo.upload-dir           -> PHOTO_UPLOADDIR
#
# 환경변수는 application-live.yml 보다 우선합니다.

# --- 프로파일 ---
# 이미지에 SPRING_PROFILES_ACTIVE=live 가 박혀 있어 지정하지 않아도 됩니다.
# 네이티브 이미지는 AOT 가 @Profile 판정을 빌드 시점에 확정하므로 live 외의
# 프로파일로는 띄울 수 없습니다 (비 live 어댑터가 이미지에 없습니다).
#SPRING_PROFILES_ACTIVE=live

# --- MySQL (필수) ---
# application-live.yml 이 이 값들로 JDBC URL 을 조립합니다.
# HOST / USERNAME / PASSWORD 에는 기본값이 없어 비우면 기동 시점에 바로 실패합니다.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=lifelog
MYSQL_USERNAME=lifelog_app
MYSQL_PASSWORD=

# TLS 를 제공하는 관리형 MySQL(Aiven 등)은 REQUIRED 로 둡니다.
# 같은 호스트에 직접 띄운 MySQL 처럼 TLS 가 없으면 DISABLED 로 바꾸되,
# 그 경우 MySQL 8 의 caching_sha2_password 가 공개키를 요구하므로
# MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true 도 함께 켜야 합니다.
# 공개키를 평문 구간으로 받는 것은 중간자 공격에 노출되므로 기본값은 false 입니다.
MYSQL_SSL_MODE=REQUIRED
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=false

# --- MongoDB (필수) ---
# 비우면 기동 시점에 바로 실패합니다.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/lifelog

# --- Redis / Valkey (필수, live 프로파일에서만 사용) ---
# 비우면 기동 시점에 바로 실패합니다. TLS 가 없는 상대면 redis:// 와
# REDIS_SSL_ENABLED=false 를 함께 지정하십시오.
REDIS_URL=rediss://<user>:<password>@<host>:<port>
REDIS_SSL_ENABLED=true

# --- OpenAI (필수) ---
# 비우면 OpenAiConfig 가 기동 시점에 실패합니다.
SPRING_AI_OPENAI_API_KEY=

# 게시글 요약에 쓰는 모델. OpenAiConfig 의 기본값은 gpt-3.5-turbo 입니다.
#PRIORITY_FINETUNING_BASEMODEL=gpt-3.5-turbo

# --- 관측(로그 + trace) ---
# 로그는 Loki, trace 는 OTLP(Tempo / collector) 로 애플리케이션이 직접 보냅니다.
# OpenTelemetry Java agent 는 쓰지 않습니다.
#
# trace 엔드포인트의 기본 호스트는 LOKI_URL 에서 뽑습니다. 둘은 보통 같은 관측
# 스택이므로 호스트를 두 번 적지 않게 했습니다. 아래 한 줄만 지정하면
#   LOKI_URL=http://host.docker.internal:3100/loki/api/v1/push
#   -> trace 는 http://host.docker.internal:4318/v1/traces 로 갑니다.
# 컨테이너 안의 localhost 는 자기 자신이라 기본값으로는 전송이 실패하므로,
# Loki 나 Tempo 를 쓰지 않더라도 주소를 지정해 두는 편이 낫습니다.
LOKI_URL=http://host.docker.internal:3100/loki/api/v1/push

# trace 를 Loki 와 다른 호스트/포트로 보낼 때만 엔드포인트를 통째로 지정합니다.
# 환경변수가 yml 의 기본값보다 우선합니다.
#MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENDPOINT=http://tempo.internal:4318/v1/traces

# 수집기가 떠 있지 않을 때의 동작. 연속 maxAttempts 회 실패하면 전송을 멈추고,
# 그 뒤로는 retryInterval 간격으로 수집기에 TCP 연결을 확인해 닿으면 전송을
# 재개합니다. 확인은 전용 스케줄러가 돌리므로 트래픽이 없는 동안에도 간격을
# 지킵니다. probeTimeout 은 확인 1회의 connect timeout 입니다.
# (기본값: 3회 / 1시간 / 2초. resilient=false 면 OpenTelemetry 기본 동작)
#TRACING_EXPORTER_MAXATTEMPTS=3
#TRACING_EXPORTER_RETRYINTERVAL=1h
#TRACING_EXPORTER_PROBETIMEOUT=2s
#TRACING_EXPORTER_RESILIENT=true

# 로그(Loki) 전송도 같은 정책입니다. logback 은 Spring 속성이 아니라 환경변수를
# 직접 읽으므로 이름이 다릅니다. 연결 확인 대상은 LOKI_URL 의 host:port 입니다.
#LOKI_MAX_ATTEMPTS=3
#LOKI_RETRY_INTERVAL_MS=3600000
#LOKI_PROBE_TIMEOUT_MS=2000

# --- Google Drive ---
# 이미지가 file:/app/config/credential.json 을 기본값으로 갖습니다. credential.json
# 을 다른 경로에 마운트할 때만 지정합니다. 네이티브 이미지는 클래스패스 리소스를
# 빌드 시점에 임베드하므로 마운트한 파일은 반드시 file: 경로로 줘야 합니다.
#GOOGLE_CREDENTIALLOCATION=file:/app/config/credential.json

# --- 기타 ---
#PHOTO_UPLOADDIR=lifelog/pictures
#WEBSOCKET_ALLOWEDORIGINS_0=https://furaiki-lifelog.com

# 사진 업로드 상한. application.yml 기본값은 20MB / 50MB 입니다.
#SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=20MB
#SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=50MB

# live 는 trace 를 전량 수집합니다(1.0). 트래픽이 늘면 낮추십시오.
#MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0

# JDBC URL 을 통째로 지정해야 할 때만 씁니다. 위의 MYSQL_* 로 조립한 URL 을
# 덮어쓰므로, 이 값을 주면 sslMode 등도 직접 넣어야 합니다.
#SPRING_DATASOURCE_URL=jdbc:mysql://host:3306/lifelog?sslMode=REQUIRED

# 포트는 바꾸지 마십시오. 이미지의 HEALTHCHECK 가 컨테이너 안의 8080 을 직접
# 열어 보므로, 바꾸면 기동은 되지만 영구 unhealthy 가 됩니다.
# 외부 포트만 바꾸려면 docker run -p 로 바꾸십시오.
#SERVER_PORT=8080
