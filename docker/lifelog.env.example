# lifelog (app) 컨테이너 환경변수 템플릿
#   cp docker/lifelog.env.example docker/lifelog.env  (lifelog.env 는 gitignore 대상)
#   docker run --env-file docker/lifelog.env ...
#
# Spring relaxed binding 규칙: 점 -> 밑줄, 대시 제거, 전부 대문자
#   spring.datasource.url      -> SPRING_DATASOURCE_URL
#   kafka.ssl.key-location     -> KAFKA_SSL_KEYLOCATION

# --- 필수 ---
SPRING_PROFILES_ACTIVE=live
# application-live.yml 의 ENC(...) 값을 복호화하는 키. 없으면 기동 실패
JASYPT_ENCRYPTOR_PASSWORD=

# --- OpenAI ---
SPRING_AI_OPENAI_API_KEY=

# --- 컨테이너에서 반드시 덮어써야 하는 값 ---
# live yml 은 http://127.0.0.1:4318 이며, 컨테이너 안에서 127.0.0.1 은 자기 자신임
MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENDPOINT=http://host.docker.internal:4318/v1/traces

# --- Kafka SSL 인증서 (마운트한 경로를 file: 로 지정) ---
KAFKA_SSL_KEYLOCATION=file:/app/certs/service.key
KAFKA_SSL_CERTIFICATELOCATION=file:/app/certs/service.cert
KAFKA_SSL_CALOCATION=file:/app/certs/ca.pem

# --- 아래는 live yml 에 ENC 값으로 이미 들어있음. 평문 주입으로 바꾸려면 주석 해제 ---
#SPRING_DATASOURCE_URL=
#SPRING_DATASOURCE_USERNAME=
#SPRING_DATASOURCE_PASSWORD=
#SPRING_DATA_REDIS_URL=
#SPRING_MONGODB_URI=
#SPRING_KAFKA_BOOTSTRAP_SERVERS=

# --- 기타 ---
#PHOTO_UPLOADDIR=lifelog/pictures
#WEBSOCKET_ALLOWEDORIGINS_0=https://furaiki-lifelog.com
